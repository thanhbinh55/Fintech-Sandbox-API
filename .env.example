# Fintech Sandbox API - Environment Configuration

PROJECT_NAME="Fintech Sandbox API"
API_V1_PREFIX="/v1"
DEBUG=true
ENVIRONMENT=development

# Database configuration
# For local dev / testing fallback: sqlite:///./fintech_sandbox.db
# For PostgreSQL in Docker / Production: postgresql+psycopg://fintech:fintech_secret@localhost:5432/fintech_sandbox
DATABASE_URL=sqlite:///./fintech_sandbox.db

# Security & Tokens
# Secret key used for signing / verifying session tokens
SECRET_KEY=demo_dev_secret_key_change_in_production_32bytes_min!
SESSION_TOKEN_EXPIRE_HOURS=24

# Demo Session Settings
DEFAULT_SEED_SCENARIO=scenario_a
ALLOW_DEMO_RESET=true

# Service Host & Port
HOST=0.0.0.0
PORT=8000
