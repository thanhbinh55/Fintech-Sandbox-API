  "components": {
    "schemas": {
      "ContactCreate": {
        "properties": {
          "display_name": {
            "type": "string",
            "title": "Display Name"
          },
          "alias": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Alias"
          },
          "phone_number": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Phone Number"
          },
          "recipient_account_id": {
            "type": "string",
            "title": "Recipient Account Id"
          },
          "bank_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bank Name"
          }
        },
        "type": "object",
        "required": [
          "display_name",
          "recipient_account_id"
        ],
        "title": "ContactCreate"
      },
      "DemoSessionCreate": {
        "properties": {
          "scenario": {
            "type": "string",
            "title": "Scenario",
            "description": "Seed scenario: scenario_a, scenario_b, scenario_c",
            "default": "scenario_a"
          },
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name",
            "description": "Optional custom session label"
          }
        },
        "type": "object",
        "title": "DemoSessionCreate"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PaymentApprovalRequest": {
        "properties": {
          "quote_id": {
            "type": "string",
            "title": "Quote Id",
            "description": "ID of the approved payment quote"
          }
        },
        "type": "object",
        "required": [
          "quote_id"
        ],
        "title": "PaymentApprovalRequest"
      },
      "PaymentExecuteRequest": {
        "properties": {
          "idempotency_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Idempotency Key",
            "description": "Optional client idempotency key to prevent double execution"
          }
        },
        "type": "object",
        "title": "PaymentExecuteRequest"
      },
      "PaymentIntentCreate": {
        "properties": {
          "recipient_account_id": {
            "type": "string",
            "title": "Recipient Account Id",
            "description": "Target simulated recipient account ID"
          },
          "amount_vnd": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Amount Vnd",
            "description": "Principal payment amount in VND (strictly integer)"
          },
          "description": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Description",
            "description": "Transfer note or bill description"
          },
          "merchant_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Merchant Id",
            "description": "Optional merchant identifier for category-specific offers"
          }
        },
        "type": "object",
        "required": [
          "recipient_account_id",
          "amount_vnd",
          "description"
        ],
        "title": "PaymentIntentCreate"
      },
      "SplitBillCreate": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title",
            "description": "Bill title or event name",
            "default": "Bữa ăn trưa"
          },
          "payer_name": {
            "type": "string",
            "title": "Payer Name",
            "description": "Name of the person who originally paid the full bill"
          },
          "participants": {
            "items": {
              "$ref": "#/components/schemas/SplitParticipantInput"
            },
            "type": "array",
            "minItems": 2,
            "title": "Participants",
            "description": "List of at least two participants"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/SplitItemInput"
            },
            "type": "array",
            "minItems": 1,
            "title": "Items",
            "description": "Itemized bill entries"
          },
          "tax_vnd": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Tax Vnd",
            "description": "Total VAT or tax in VND to be shared proportionally",
            "default": 0
          },
          "service_fee_vnd": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Service Fee Vnd",
            "description": "Service charge in VND to be shared proportionally",
            "default": 0
          },
          "discount_vnd": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Discount Vnd",
            "description": "Global discount in VND to be subtracted proportionally",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "payer_name",
          "participants",
          "items"
        ],
        "title": "SplitBillCreate"
      },
      "SplitItemInput": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Item description (e.g., Cơm tấm, Nước cam)"
          },
          "unit_price_vnd": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Unit Price Vnd",
            "description": "Unit price in integer VND"
          },
          "quantity": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Quantity",
            "description": "Quantity",
            "default": 1
          },
          "assigned_participant_names": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Assigned Participant Names",
            "description": "Names of participants sharing this item. Empty means shared equally by all."
          }
        },
        "type": "object",
        "required": [
          "name",
          "unit_price_vnd"
        ],
        "title": "SplitItemInput"
      },
      "SplitParticipantInput": {
        "properties": {
          "display_name": {
            "type": "string",
            "title": "Display Name",
            "description": "Participant name"
          },
          "user_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "User Id",
            "description": "Linked user ID if participant has an internal account"
          }
        },
        "type": "object",
        "required": [
          "display_name"
        ],
        "title": "SplitParticipantInput"
      },
      "SplitSettleRequest": {
        "properties": {
          "collected_amount_vnd": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Collected Amount Vnd",
            "description": "Amount collected in VND. If omitted, marks full remaining amount as paid."
          }
        },
        "type": "object",
        "title": "SplitSettleRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
